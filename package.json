{
  "name": "uniao-farma-sabara",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vinext build && node scripts/normalize-cloudflare-config.mjs",
    "start": "vinext start",
    "test": "node --test tests/a11y-static.test.mjs tests/offers.test.mjs tests/news.test.mjs tests/staff-auth.test.mjs tests/current-site.test.mjs tests/hours-exceptions.test.mjs tests/seo-conventions.test.mjs",
    "test:html": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint app tests scripts worker db --ignore-pattern dist --ignore-pattern .next --ignore-pattern build --ignore-pattern work --ignore-pattern outputs --ignore-pattern .wrangler",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.9",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.5",
    "react-server-dom-webpack": "19.3.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.10",
    "vite": "8.3.0",
    "wrangler": "4.131.2"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  },
  "type": "module"
}
