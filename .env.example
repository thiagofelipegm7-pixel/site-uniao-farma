# Leave empty to use the existing direct GA4 loader.
NEXT_PUBLIC_GTM_CONTAINER_ID=GTM-M8BXJCHB

# Existing GA4 property. If GTM is configured, create the GA4 tag inside GTM
# and keep this value as documentation only to avoid loading GA4 twice.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-1N8E5G39KF

# Google Search Console HTML verification token (not the full meta tag).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=chgP6OWdJAiM-yv_oPbit7Rf91vAsI7xDUWEuNQG1xk

# Optional Google Ads direct conversion tracking. Keep blank when conversions
# are configured inside GTM instead.
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_WHATSAPP_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_PHONE_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_DELIVERY_LABEL=
# Habilita a fila interna apenas em builds locais de revisão. Nunca ative em produção.
OFFERS_REVIEW_MODE=false
